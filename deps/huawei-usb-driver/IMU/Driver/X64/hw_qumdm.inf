;=============== Installation Section Begin ===================
; ###### Installation FP Section ######
[FPModem.NT]
CopyFiles=CopyFileSection
AddReg = All, MfgAddReg, Modem1.AddReg, USB

[FPModem.NT.Services]
AddService=HWHandSet, 0x00000000, HW_USBSerialServiceFP

[FPModem.NT.HW]
AddReg=LowerFilterAddReg2

[HW_USBSerialServiceFP]
DisplayName   = "HUAWEIFPMODEM"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg	      = PowerReg

; ************* Installation FWT0 Section *************
[FWTModem0.NT]
CopyFiles=CopyFileSection
AddReg = All, MfgAddReg, Modem1.AddReg, USB


[FWTModem0.NT.Services]
AddService=HWHandSet, 0x00000000, HW_USBSerialServiceFWT0

[FWTModem0.NT.HW]
AddReg=LowerFilterAddReg2

[HW_USBSerialServiceFWT0]
DisplayName   = "HUAWEIFWTMODEM0"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg	      = PowerReg

; *==**==**==**==* Installation FWT1 Section *==**==**==**==*
[FWTModem1.NT]
CopyFiles=CopyFileSection
AddReg = All, MfgAddReg, Modem1.AddReg, USB


[FWTModem1.NT.Services]
AddService=HWHandSet, 0x00000000, HW_USBSerialServiceFWT1

[FWTModem1.NT.HW]
AddReg=LowerFilterAddReg2

[HW_USBSerialServiceFWT1]
DisplayName   = "HUAWEIFWTMODEM1"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg	      = PowerReg

; @@@@@@@@@@@@@@@@@ Installation SP Section @@@@@@@@@@@@@@@@@@
[SPModem.NT]
CopyFiles=CopyFileSection
AddReg = All, SPMfgAddReg, SPModem1.AddReg, USB


[SPModem.NT.Services]
AddService=HWHandSet, 0x00000000, HW_USBSerialServiceSP

[SPModem.NT.HW]
AddReg=LowerFilterAddReg2

[HW_USBSerialServiceSP]
DisplayName   = "HUAWEISPMODEM"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg	      = PowerReg

;================ Installation SP-TMO Section =================
[SPTMOModem.NT]
CopyFiles=CopyFileSection
AddReg = All, SPTMOMfgAddReg, SPModem1.AddReg, USB


[SPTMOModem.NT.Services]
AddService=HWHandSet, 0x00000000, HW_USBSerialServiceSPTMO

[SPTMOModem.NT.HW]
AddReg=LowerFilterAddReg2

[HW_USBSerialServiceSPTMO]
DisplayName   = "HUAWEISPTMOMODEM"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg	      = PowerReg

;>>>>>>>>>>>>>>>>>>>>> The Union Version <<<<<<<<<<<<<<<<<<<<<<
[HWPortInstallFP.NT]
CopyFiles=CopyFileSection
AddReg = All, MfgAddReg, Modem1.AddReg, USB


[HWPortInstallFP.NT.Services]
AddService=HWHandSet, 0x00000000, HW_USBSerialServiceUnion

[HWPortInstallFP.NT.HW]
AddReg=LowerFilterAddReg2

[HW_USBSerialServiceUnion]
DisplayName   = "HUAWEIMODEMUNION"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hw_quusbmdm.sys
;AddReg	      = PowerReg

;============== Installation Section End ======================

[LowerFilterAddReg2]
HKR,,"LowerFilters",0x00010000,"HWHandSet"

[CopyFileSection]
hw_quusbmdm.sys,,,0x20

[Strings]
HUAWEI           = "Huawei Incorporated"
HWSRCDISK        = "HUAWEI Multimedia USB Driver Disk"
;
HUAWEISPMODEM    = "USB Device for Legacy Serial Communication (Normal)"
HUAWEISPTMOMODEM = "USB Device for Legacy Serial Communication (T-Mobile)"
HUAWEI00         = "Android Adapter Modem (for Logo Test)"
HUAWEI000         = "T-Mobile 3G Phone Modem (for Logo Test)"
HUAWEI01         = "Android Adapter Modem"
HUAWEI02         = "T-Mobile 3G Phone Modem"
;
HUAWEIFPMODEM    = "Huawei Mobile USB Modem and USB Serial"
HUAWEI10         = "HUAWEI CDMA Handset - Modem"
HUAWEI13         = "HUAWEI FP Handset - Modem"
;
HUAWEIFWTMODEM0  = "High Speed USB Modem and USB Serial For Normal"
HUAWEIFWTMODEM1  = "Huawei Mobile Adapter USB Modem and USB Serial"
HUAWEI20         = "Mobile Adapter - Modem"
HUAWEI21         = "DBAdapter - Modem"
HUAWEI22         = "Mobile Adapter - ETS Modem"
HWFWT202         = "HUAWEI Mobile Connect - 3G Modem"
HWFWT203         = "HUAWEI Mobile Connect - Modem"
;
;>>>New Union programed Products Later <<<
;
HUAWEIMODEMUNION = "Huawei HandSet USB Modem and USB Serial"
HUAWEI90         = "Huawei HandSet - Modem"

[All]
HKR,,PortIdentify,,HWMODEM
HKR,,FriendlyDriver,0,Unimodem.vxd
HKR,,DevLoader,0,*vcomm
HKR,,ConfigDialog,0,modemui.dll
HKR,,EnumPropPages,0,modemui.dll,EnumPropPages
HKR,,PortSubClass,1,02
HKR, Init,      1,, "AT<cr>"

[Modem1.AddReg]
HKR,, Properties, 1, 80,01,00,00, 00,00,00,00, 00,00,00,00, 00,00,00,00, 00,00,00,00,00,01,00,00, 00,08,07,00, 00,08,07,00

[SPModem1.AddReg]
HKR,, Properties, 1, 80,01,00,00, 00,00,00,00, 00,00,00,00, 07,00,00,00, 0F,00,00,00, 00,01,00,00, 00,08,07,00, 00,08,07,00
HKR,, FClass, 1, c3,00,00,00
HKR, Fax, CL1FCS,, "2"
HKR, Fax, HardwareFlowControl,, "1"

[USB]
HKR,, DeviceType, 1, 01
HKR,,Contention,,""

[PowerReg]
HKR,,QCDriverResident,0x00010001,1


[MfgAddReg]
HKR,, InactivityScale,1, 3c,00,00,00
HKR, Init, 1,, "AT<cr>" 
HKR, Init, 2,, "AT&FE0V1X1&D2&C1S0=0<cr>"
HKR, Monitor, 1,, "ATS0=0<cr>"
HKR, Monitor, 2,, "None"
HKR, Answer,    1,, "ATA<cr>"
HKR, Hangup,    1,, "ATH E1<cr>"
HKR,, Reset,, "AT&F<cr>"   
HKR, Settings, Prefix,, "AT"
HKR, Settings, Terminator,, "<cr>"
HKR, Settings, DialPrefix,, "D"
HKR, Settings, DialSuffix,, ""
;HKR, Settings, CallSetupFailTimer,, ""
HKR, Settings, Pulse,, "P"
HKR, Settings, Tone,, "T"
;HKR, Settings, InactivityTimeOut,, ""

HKR, Responses, "0<cr>",                       1, 00, 00, 00,00,00,00, 00,00,00,00 ; OK - Command executed
HKR, Responses, "1<cr>",                       1, 02, 00, 00,00,00,00, 00,00,00,00 ; CONNECT - Connection
HKR, Responses, "2<cr>",                       1, 08, 00, 00,00,00,00, 00,00,00,00 ; RING - Ring signal indicated
HKR, Responses, "3<cr>",                       1, 04, 00, 00,00,00,00, 00,00,00,00 ; NO CARRIER 
HKR, Responses, "4<cr>",                       1, 03, 00, 00,00,00,00, 00,00,00,00 ; ERROR - Invalid command
HKR, Responses, "5<cr>",                       1, 02, 00, B0,04,00,00, 00,00,00,00 ; CONNECT 1200
HKR, Responses, "6<cr>",                       1, 05, 00, 00,00,00,00, 00,00,00,00 ; NO DIALTONE - No dial tone detected
HKR, Responses, "7<cr>",                       1, 06, 00, 00,00,00,00, 00,00,00,00 ; BUSY - Engaged (busy) signal
HKR, Responses, "8<cr>",                       1, 07, 00, 00,00,00,00, 00,00,00,00 ; NO ANSWER
